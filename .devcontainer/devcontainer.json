{
  "name": "VPS Browser Cloud",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableOnDataRoot": true
    }
  },
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "VPS Browser Desktop UI",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "8080": {
      "label": "VPS Browser Mobile Proxy",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postStartCommand": "bash server/codespace_startup.sh"
}
